# --- Opcionales ---
# Máximo de estudiantes activos por sección (por defecto 50)
MAX_ESTUDIANTES_SECCION=50
# Horas que se suman solas cuando un estudiante queda "Justificado" en la asistencia (por defecto 2)
HORAS_PERMISO=2
# Carpeta donde se guardan los documentos de los proyectos (por defecto ./uploads) y tamaño máximo por archivo en MB (por defecto 10)
UPLOADS_DIR=./uploads
MAX_ARCHIVO_MB=10

# Si publicas el sistema detrás de un proxy (Render, Railway, Nginx...), pon 1 para que el límite de intentos use la IP real de cada dispositivo
TRUST_PROXY=1

# Zona horaria para validar fechas de avisos y calendario (por defecto America/El_Salvador)
ZONA_HORARIA=America/El_Salvador
